{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "es2022",
		"moduleResolution": "Bundler",
		"types": ["./worker-configuration.d.ts"],
		"resolveJsonModule": true,
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
