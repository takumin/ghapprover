{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices"],
	"timezone": "Asia/Tokyo",
	"automerge": true,
	"packageRules": [
		{
			"groupName": "node",
			"matchPackageNames": ["node"],
			"versioning": "node",
			"separateMajorMinor": false
		},
		{
			"groupName": "pnpm",
			"matchPackageNames": ["pnpm"],
			"separateMajorMinor": false
		},
		{
			"groupName": "oxc",
			"matchPackageNames": ["oxfmt", "oxlint", "oxlint-tsgolint"],
			"separateMajorMinor": false
		}
	]
}
