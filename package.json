{
	"name": "ghapprover",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typegen": "wrangler types",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"test": "vitest run"
	},
	"dependencies": {
		"@octokit/auth-app": "8.3.1",
		"@octokit/core": "7.0.8",
		"@octokit/plugin-paginate-rest": "16.0.0",
		"@octokit/request-error": "7.1.2",
		"@octokit/webhooks-methods": "6.0.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.6",
		"@octokit/openapi-webhooks-types": "12.2.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"wrangler": "4.151.3"
	},
	"engines": {
		"node": "24.22.1",
		"npm": "USE_PNPM",
		"pnpm": "12.15.0"
	},
	"packageManager": "pnpm@12.15.0"
}
