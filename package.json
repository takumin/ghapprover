{
	"name": "ghapprover",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typegen": "wrangler types",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"test": "vitest run"
	},
	"dependencies": {
		"@octokit/auth-app": "8.3.1",
		"@octokit/core": "7.0.8",
		"@octokit/plugin-paginate-rest": "15.0.0",
		"@octokit/request-error": "7.1.2",
		"@octokit/webhooks-methods": "6.0.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@octokit/openapi-webhooks-types": "12.1.0",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "7.0.2002",
		"typescript": "7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.136.1"
	},
	"engines": {
		"node": "24.21.0",
		"npm": "USE_PNPM",
		"pnpm": "12.5.1"
	},
	"packageManager": "pnpm@12.5.1"
}
