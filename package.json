{
	"name": "ghapprover",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typegen": "wrangler types",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.18.8",
		"oxfmt": "0.60.0",
		"oxlint": "1.75.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "4.1.10",
		"wrangler": "4.114.0"
	},
	"engines": {
		"node": "24.18.0",
		"npm": "USE_PNPM",
		"pnpm": "11.17.0"
	},
	"packageManager": "pnpm@11.17.0"
}
