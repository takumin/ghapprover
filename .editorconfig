root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = tab
indent_size              = 2
insert_final_newline     = true
trim_trailing_whitespace = true

[*.{sh,bash}]
switch_case_indent = true
space_redirects    = true
binary_next_line   = true
function_next_line = true

[*.{yaml,yml}]
indent_style = space

[*.toml]
indent_style = space

# oxfmt owns the layout here, and Markdown indentation is semantic rather than
# stylistic: ordered-list continuations are 3 spaces wide, and a fenced block
# carries whatever indentation its own language uses, tabs included.
[*.md]
indent_style = unset

# Verbatim upstream text. No formatter here touches it, so nothing should have
# an opinion on its layout either.
[LICENSE]
indent_style = unset

[worker-configuration.d.ts]
indent_style = unset
trim_trailing_whitespace = unset
