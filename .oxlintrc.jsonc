{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// `node` is carried for node/no-process-env alone, which mechanically enforces
	// SPEC §5: there is no dynamic configuration, so nothing may read the
	// environment. The rest carry the rules the categories below switch on.
	"plugins": ["typescript", "unicorn", "oxc", "promise", "import", "node"],
	// The lint gate stands in for human code review here, so every judgement a
	// machine can make is made by the machine: enable every category, then switch
	// off only what fights the codebase. `nursery` is the one category left off,
	// because it carries eslint/no-undef, which is actively wrong for TypeScript;
	// the nursery rules worth having are named individually under "rules".
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error",
		"pedantic": "error",
		"style": "error",
		"restriction": "error",
	},
	"options": {
		// Declared here rather than in the package.json lint scripts, so that an
		// editor or a CI run of the oxlint binary cannot silently skip every
		// type-aware rule.
		"typeAware": true,
		"typeCheck": true,
		// An `oxlint-disable` that no longer suppresses anything is itself an
		// error, so an exemption cannot outlive the reason it was written for.
		"reportUnusedDisableDirectives": "error",
		// Every finding fails the gate, whatever severity its rule ships with.
		"denyWarnings": true,
	},
	// Generated by `wrangler types` (mise run typegen), so it is excluded rather
	// than fixed.
	"ignorePatterns": ["worker-configuration.d.ts"],
	"rules": {
		// Tuned rather than switched off: function declarations and `_` stay
		// writable while the rules still bite everywhere else.
		"eslint/func-style": ["error", "declaration", { "allowArrowFunctions": true }],
		"eslint/id-length": ["error", { "min": 2, "exceptions": ["_"] }],
		// Pairs with typescript/consistent-type-imports below. Without the
		// exemption the two rules contradict each other: this one counted an
		// `import type { X }` beside an existing value import from the same module
		// as a duplicate, while import/consistent-type-specifier-style rejected the
		// inline `{ type X }` spelling, leaving no way to import a type from a
		// module whose values are already imported. A second *value* import of an
		// already-imported module is still reported.
		"eslint/no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
		// Tuned, as above: 0/1/-1 and array indexes stay writable.
		"eslint/no-magic-numbers": [
			"error",
			{ "enforceConst": true, "ignore": [0, 1, -1], "ignoreArrayIndexes": true },
		],
		// `undefined` is how absence is spelled throughout: the SPEC §8 diagnostics
		// an outcome does not carry (src/pipeline.ts), and the validation result
		// with no field to name (src/payload.ts). `null` cannot stand in for it --
		// `null` is a value the GitHub payloads really carry.
		"eslint/no-undefined": "off",
		// Nursery rules worth having. No enabled category carries them, so each is
		// named individually.
		"eslint/no-unreachable-loop": "error",
		"eslint/no-useless-assignment": "error",
		// Not the duplicate of typescript/require-await the name suggests: this one
		// also reports an `async` function that returns a promise without awaiting
		// it, which is the shape most of the async helpers in src/ have. It cannot
		// be an error while two enabled rules stand: typescript/promise-function-async
		// requires a promise-returning helper to be async, and typescript/return-await
		// (in-try-catch) forbids the `return await` that would appease this rule
		// outside a try/catch — together the three would leave a pass-through helper
		// no legal spelling at all. The type-aware rule, which reports only a
		// function with nothing async about it at all, is left on by category to
		// carry the check.
		"eslint/require-await": "off",
		// The import group, in the order oxlint sorts it:
		// - no-named-export and prefer-default-export each contradict
		//   no-default-export, which the restriction category keeps on: the first
		//   pair as errors leaves a module nothing it may export, and the second
		//   orders the single-export modules to write the default export the
		//   enabled rule bans. The named shape is also what lets SPEC §12's
		//   decision logic be unit-tested without mocking the GitHub API.
		// - exports-last and group-exports reject export-at-declaration, the shape
		//   every module here is written in: satisfying them restates every public
		//   declaration in a trailing export block without changing anything a
		//   rule could catch afterwards.
		// - no-default-export bans the Workers entrypoint, so the two declarations
		//   that cannot avoid a default export (src/index.ts, vitest.config.mts)
		//   carry a line exemption rather than the rule being switched off for
		//   whole files.
		"import/exports-last": "off",
		// Reports nothing against the extensionless imports this codebase writes, so
		// it is carried as a guard on that style rather than switched off.
		"import/extensions": "error",
		"import/group-exports": "off",
		"import/no-named-export": "off",
		"import/prefer-default-export": "off",
		// Bans async/await outright, while the enabled
		// typescript/promise-function-async requires every promise-returning
		// function to be async: as errors the pair leaves no legal way to return a
		// promise, and a Worker's fetch handler returns nothing else.
		"oxc/no-async-await": "off",
		// Nursery, as above.
		"promise/no-return-in-finally": "error",
		// Pairs with eslint/no-duplicate-imports above, and is what makes that
		// exemption safe to grant: the exemption only holds while a type import is
		// always spelled as a separate `import type { X }` declaration. `prefer`
		// forces a type-only import to be spelled as a type import at all, and
		// `fixStyle` keeps the autofix from writing the inline `{ type X }` form
		// that import/consistent-type-specifier-style then rejects. Both match
		// oxlint's current defaults and are pinned so the pair cannot drift apart
		// if a default changes.
		"typescript/consistent-type-imports": [
			"error",
			{ "prefer": "type-imports", "fixStyle": "separate-type-imports" },
		],
		// On by category already; the entry is here for `ignoreVoid: false`, which
		// stops a `void` prefix from silencing it.
		"typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
		// Nursery, as above.
		"typescript/no-unnecessary-condition": "error",
		"typescript/prefer-optional-chain": "error",
		// Too broad for the boundary this Worker sits on: most signatures take a
		// foreign type — the runtime's Request, the generated Env, the octokit
		// client — that is not deeply readonly and not this codebase's to change.
		"typescript/prefer-readonly-parameter-types": "off",
		// GitHub's webhook payloads and REST responses really carry `null`, and the
		// frozen contract (src/types.ts) models that absence as `null` rather than
		// converting it -- `undefined` is already spoken for as the parse-failure
		// sentinel (see eslint/no-undefined above), so the two cannot be collapsed.
		// Banning the literal would leave no way to spell the shape the API sends,
		// in src or in the fixtures that stand in for it.
		"unicorn/no-null": "off",
	},
	"overrides": [
		{
			"files": ["vitest.config.mts", "test/**/*.ts"],
			"plugins": ["vitest"],
			"rules": {
				// The tests import from `../src`.
				"import/no-relative-parent-imports": "off",
				// vitest globals are not enabled (see vitest.config.mts), so the
				// suites import `describe`/`it`/`expect` explicitly — the spelling
				// the enabled vitest/prefer-importing-vitest-globals requires; as
				// errors the pair would leave a suite no way to name its test
				// functions.
				"vitest/no-importing-vitest-globals": "off",
			},
		},
	],
}
