{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// `node` is carried for node/no-process-env alone, which mechanically enforces
	// SPEC §5: there is no dynamic configuration, so nothing may read the
	// environment. The rest carry the rules the categories below switch on.
	"plugins": ["typescript", "unicorn", "oxc", "promise", "import", "node"],
	// The lint gate stands in for human code review here, so every judgement a
	// machine can make is made by the machine: enable every category, then switch
	// off only what fights the codebase. `nursery` is the one category left off,
	// because it carries eslint/no-undef, which is actively wrong for TypeScript;
	// the nursery rules worth having are named individually under "rules".
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error",
		"pedantic": "error",
		"style": "error",
		"restriction": "error",
	},
	"options": {
		// Declared here rather than in the package.json lint scripts, so that an
		// editor or a CI run of the oxlint binary cannot silently skip every
		// type-aware rule.
		"typeAware": true,
		"typeCheck": true,
		// An `oxlint-disable` that no longer suppresses anything is itself an
		// error, so an exemption cannot outlive the reason it was written for.
		"reportUnusedDisableDirectives": "error",
		// Every finding fails the gate, whatever severity its rule ships with.
		"denyWarnings": true,
	},
	// Generated by `wrangler types` (mise run typegen), so it is excluded rather
	// than fixed.
	"ignorePatterns": ["worker-configuration.d.ts"],
	"rules": {
		// Tuned rather than switched off: function declarations and `_` stay
		// writable while the rules still bite everywhere else.
		"eslint/func-style": ["error", "declaration", { "allowArrowFunctions": true }],
		"eslint/id-length": ["error", { "min": 2, "exceptions": ["_"] }],
		// Pairs with typescript/consistent-type-imports below. Without the
		// exemption the two rules contradict each other: this one counted an
		// `import type { X }` beside an existing value import from the same module
		// as a duplicate, while import/consistent-type-specifier-style rejected the
		// inline `{ type X }` spelling, leaving no way to import a type from a
		// module whose values are already imported. A second *value* import of an
		// already-imported module is still reported.
		"eslint/no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
		// Tuned, as above: 0/1/-1 and array indexes stay writable.
		"eslint/no-magic-numbers": [
			"error",
			{ "enforceConst": true, "ignore": [0, 1, -1], "ignoreArrayIndexes": true },
		],
		// `undefined` is how absence is spelled throughout: the SPEC §8 diagnostics
		// an outcome does not carry (src/outcome.ts), the validation result with no
		// field to name (src/pipeline.ts), and every "no problem found" a §3 check
		// answers with. `null` cannot stand in for it -- `null` is a value the GitHub
		// payloads really carry, which is what unicorn/no-null below now enforces.
		"eslint/no-undefined": "off",
		// Nursery rules worth having. No enabled category carries them, so each is
		// named individually.
		"eslint/no-unreachable-loop": "error",
		"eslint/no-useless-assignment": "error",
		// Not the duplicate of typescript/require-await the name suggests: this one
		// also reports an `async` function that returns a promise without awaiting
		// it, so a pass-through helper has to await the call it forwards and the
		// promise is settled inside the frame that made it — the try/catch in
		// src/github.ts only catches what it awaits. Two enabled rules rule out the
		// obvious spellings: typescript/promise-function-async requires a
		// promise-returning helper to be async, and typescript/return-await
		// (in-try-catch) forbids `return await` outside a try/catch. What passes all
		// three is the intermediate variable — `const x = await f(); return x;` —
		// which is the shape every pass-through helper here is written in.
		"eslint/require-await": "error",
		// The import group, in the order oxlint sorts it:
		// - no-named-export contradicts no-default-export, which the restriction
		//   category keeps on: as errors the pair leaves a module nothing it may
		//   export. The named shape is also what lets SPEC §12's decision logic be
		//   unit-tested without mocking the GitHub API.
		// - exports-last and group-exports together give every module one trailing
		//   export block: a declaration is private unless the block at the bottom
		//   names it, so the public surface is read off one statement rather than
		//   gathered from the `export` keywords scattered through the file. The
		//   two rules count value and type exports apart, so a module that exports
		//   both states them as `export { … }` and `export type { … }` — which is
		//   also the spelling import/consistent-type-specifier-style requires.
		// - no-default-export bans the Workers entrypoint, so the two declarations
		//   that cannot avoid a default export (src/index.ts, vitest.config.mts)
		//   carry a line exemption rather than the rule being switched off for
		//   whole files.
		// - prefer-default-export fires only on a module with a single export, and
		//   asks for the default export no-default-export bans, so with that rule
		//   standing it reads as "no module may have exactly one export". That is
		//   the shape this codebase already wants: a lone export is either a value
		//   the consumer restates because the module never offered it, or a module
		//   that only ever travels with its single caller. Keeping it an error is
		//   what stops the next one from being added silently -- and what makes
		//   the constraint permanent, since a refactor that leaves a module one
		//   export has to resolve it rather than land.
		"import/exports-last": "error",
		// Reports nothing against the extensionless imports this codebase writes, so
		// it is carried as a guard on that style rather than switched off.
		"import/extensions": "error",
		"import/group-exports": "error",
		"import/no-named-export": "off",
		"import/prefer-default-export": "error",
		// Bans async/await outright, while the enabled
		// typescript/promise-function-async requires every promise-returning
		// function to be async: as errors the pair leaves no legal way to return a
		// promise, and a Worker's fetch handler returns nothing else.
		"oxc/no-async-await": "off",
		// Nursery, as above.
		"promise/no-return-in-finally": "error",
		// Pairs with eslint/no-duplicate-imports above, and is what makes that
		// exemption safe to grant: the exemption only holds while a type import is
		// always spelled as a separate `import type { X }` declaration. `prefer`
		// forces a type-only import to be spelled as a type import at all, and
		// `fixStyle` keeps the autofix from writing the inline `{ type X }` form
		// that import/consistent-type-specifier-style then rejects. Both match
		// oxlint's current defaults and are pinned so the pair cannot drift apart
		// if a default changes.
		"typescript/consistent-type-imports": [
			"error",
			{ "prefer": "type-imports", "fixStyle": "separate-type-imports" },
		],
		// On by category already; the entry is here for `ignoreVoid: false`, which
		// stops a `void` prefix from silencing it.
		"typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
		// Nursery, as above.
		"typescript/no-unnecessary-condition": "error",
		"typescript/prefer-optional-chain": "error",
		// Enforced with an allow list rather than switched off. Plainly enabled it
		// reports the boundary this Worker sits on — the runtime's Request, the
		// octokit client, valibot's issue type — none of which is deeply readonly
		// and none of which is this codebase's to change; switched off it would
		// also stop reporting the parameters that *are* ours, which is the class of
		// regression the rule exists to catch. So the exceptions are named, and
		// only a type that is foreign or mutable by design earns a name. Matching
		// is by type name, and a type alias does not survive it: `GithubClient` is
		// listed under the octokit class it resolves to, and a parameter whose type
		// resolves to no name at all (the before-request hook's options,
		// src/client.ts) carries a line exemption instead.
		"typescript/prefer-readonly-parameter-types": [
			"error",
			{
				"allow": [
					// The Workers runtime and the Fetch API it implements: what the entry point is
					// handed (src/index.ts) and what the suites build deliveries out of.
					"AbortSignal",
					"ExecutionContext",
					"ReadableStream",
					"ReadableStreamDefaultController",
					"Request",
					"RequestInit",
					"Response",
					"URL",
					// The octokit client (src/client.ts's GithubClient is an instance of it) and the
					// one failure type the package types for us (src/api-error.ts).
					"Octokit",
					"RequestError",
					// Ours, but not readonly-able: GithubApiError extends Error, whose own
					// name/message/stack are writable and are not ours to freeze.
					"GithubApiError",
					// Ours and mutable by design: the SPEC §8 log entry is an accumulator that
					// recordDelivery/recordPayload/logOutcome build by writing into it (src/log.ts).
					"LogFields",
				],
			},
		],
		// `null` is what GitHub sends, not how this codebase says absence: the frozen
		// contract (src/types.ts) still types the payload fields that really carry it
		// as nullable, and reading such a field against `null` stays legal (the rule's
		// default checkStrictEquality: false). What the rule bans is writing the
		// literal ourselves, which is what keeps a value that came off the wire apart
		// from an absence this code decided on -- those are spelled `undefined`
		// throughout (see eslint/no-undefined above). Off for the fixtures, below.
		"unicorn/no-null": "error",
	},
	"overrides": [
		{
			"files": ["vitest.config.mts", "test/**/*.ts"],
			"plugins": ["vitest"],
			"rules": {
				// vitest globals are not enabled (see vitest.config.mts), so the
				// suites import `describe`/`it`/`expect` explicitly — the spelling
				// the enabled vitest/prefer-importing-vitest-globals requires; as
				// errors the pair would leave a suite no way to name its test
				// functions.
				"vitest/no-importing-vitest-globals": "off",
			},
		},
		// Scoped to the suites alone rather than folded into the block above, which
		// also covers vitest.config.mts: nothing in that file has a wire format to
		// spell, so it stays under the rule.
		{
			"files": ["test/**/*.ts"],
			"rules": {
				// The fixtures spell the wire format GitHub actually sends, and those
				// payloads really carry `null`; a fixture cannot exercise the nullable
				// contract branches without constructing the value itself.
				"unicorn/no-null": "off",
			},
		},
	],
}
